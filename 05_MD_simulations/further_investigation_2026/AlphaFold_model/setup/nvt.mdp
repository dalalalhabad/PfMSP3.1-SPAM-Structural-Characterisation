; NVT equilibration
integrator              = md
dt                      = 0.002
nsteps                  = 50000        ; 100 ps

; Output control
nstxout                 = 0
nstvout                 = 0
nstenergy               = 1000
nstlog                  = 1000
nstxout-compressed      = 1000

; Bond constraints
constraints             = h-bonds
constraint-algorithm    = lincs

; Neighbor searching
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2

; Electrostatics / vdW
coulombtype             = PME
rcoulomb                = 1.2
rvdw                    = 1.2

; Temperature coupling
tcoupl                  = V-rescale
tc-grps                 = Protein Water_and_ions
tau_t                   = 0.1 0.1
ref_t                   = 300 300

; Pressure coupling (OFF for NVT)
pcoupl                  = no

; Periodic boundary conditions
pbc                     = xyz

; Velocity generation
gen_vel                 = yes
gen_temp                = 300
gen_seed                = -1

from modeller import *
from modeller.automodel import *

log.verbose()
env = environ(rand_seed=-42)
env.io.atom_files_directory = './:../atom_files'
env.io.hetatm = True
env.io.water = True

a = automodel(env,
              alnfile='model.ali',
              knowns=('1PSM'),
              sequence='model')

a.starting_model = 1
a.ending_model = 1

a.md_level = refine.very_SLOW

a.make()

